# The 1-minute dispatch run. ONE-SHOT: it reads one window of the ClickHouse
# archive, posts all of it to /api/internal/settle in a single call, and exits.
#
# Started by dispatch.timer, never enabled directly.
[Unit]
Description=Signal dispatch — one window to /api/internal/settle
Documentation=file:///home/ubuntu/events-microservice/docs/IMPLEMENTATION.md
# The run reads ClickHouse over HTTP; without this a boot-time tick can fail
# once for no better reason than DNS not being up yet.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# `ubuntu`, not a separate `dispatch` service account. The tree is a git
# checkout inside ubuntu's home, deployed by `git pull && npm run build` as
# ubuntu, and /home/ubuntu is 0750 — a service account could not even traverse
# it without chmod 0755 on someone's home directory or a supplementary group,
# and would then fight the deploy over ownership of `dist/`. edge.service on the
# same box has always run as ubuntu; these three now match it.
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/events-microservice

# LOAD-BEARING. `.env` is read by the npm scripts (--env-file-if-exists), never
# by the code — src/config.ts only ever reads process.env. Invoke node directly
# without this and the process gets no configuration at all: no
# INTERNAL_SETTLE_SECRET, so it exits 2 every minute.
EnvironmentFile=/home/ubuntu/events-microservice/.env

# `dist`, not tsx: tsx type-strips the whole graph on every start, and this
# starts 1,440 times a day.
ExecStart=/usr/bin/node dist/workers/dispatch/dispatch.runner.js

# Above DISPATCH_TIMEOUT_MS (310s), so systemd never kills a settle call that is
# still committing — the window would then re-send work that actually succeeded.
TimeoutStartSec=330

# One JSON line per run, to journald. `journalctl -u dispatch -f` is the log.
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

# read-only, NOT true. `ProtectHome=true` mounts /home as an empty tmpfs inside
# the unit's own namespace, and the tree now lives at
# /home/ubuntu/events-microservice — node would start and immediately fail to
# open `dist/`. read-only keeps every protection that matters here (neither
# worker writes a byte to disk) and still lets it read `dist/`. `.env` is
# unaffected either way: systemd reads EnvironmentFile= itself, as root, before
# the namespace exists.
ProtectHome=read-only
