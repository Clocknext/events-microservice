# THE SAFETY NET. Same binary, same code path, a much wider window.
#
# The 1-minute run's 3-minute window covers any SINGLE failed tick, because the
# next two runs re-send the same signals. What it cannot cover is three
# consecutive failures — settle down for five minutes, a ClickHouse restart —
# because nothing is persisted to recover from. Those rows fall out of the window
# and are never sent again.
#
# So this runs hourly over two hours of ingestion. It re-sends an hour of already
# settled signals every hour and settle discards all of them, which costs
# bandwidth and nothing else (it is idempotent on signalId). That is the whole
# price of not needing a watermark.
[Unit]
Description=Signal dispatch reconciliation — a 2-hour window, hourly
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# `ubuntu`, not a `dispatch` service account — see dispatch.service.
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/events-microservice
EnvironmentFile=/home/ubuntu/events-microservice/.env

# THE WIDER WINDOW IS SET ON ExecStart, AND IT HAS TO BE.
#
# `Environment=` does NOT win here, whatever the ordering suggests. systemd.exec
# is explicit: "Settings from these files override settings made with
# Environment=" — so `EnvironmentFile=` above beats `Environment=` no matter
# which appears first.
#
# This unit shipped with the two values below as `Environment=` lines and a
# comment asserting the opposite, and it silently lost to `.env`: the hourly run
# logged `windowMs:180000, maxRows:100000` and was an EXACT DUPLICATE of
# dispatch.timer, with none of the gap-covering it exists for. Three consecutive
# failed minute-ticks were supposed to be caught here, and would not have been.
# Caught by reading a live `dispatch.start` line, not by reading the unit.
#
# `/usr/bin/env` sets them at exec time, after every file has been read, so no
# `.env` can take them back. Two hours of ingestion, and a cap raised to match —
# the default 100k would be hit by two hours of traffic that one minute clears.
#
# The `Environment=` lines are kept as documentation of intent, and are inert.
Environment=DISPATCH_WINDOW_MS=7200000
Environment=DISPATCH_MAX_ROWS=500000

ExecStart=/usr/bin/env DISPATCH_WINDOW_MS=7200000 DISPATCH_MAX_ROWS=500000 \
  /usr/bin/node --max-old-space-size=2048 dist/workers/dispatch/dispatch.runner.js
TimeoutStartSec=900

StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

# read-only, not true — the tree is under /home now, and `true` would hide it
# from the unit. See dispatch.service for the whole reason.
ProtectHome=read-only
