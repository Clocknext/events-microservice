{
  "name": "aws-internal",
  "version": "0.1.0",
  "description": "Fastify + TypeScript service",
  "main": "dist/server.js",
  "scripts": {
    "test": "node --import tsx --test",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:watch": "node --import tsx --test --watch",
    "build:lambdas": "node scripts/lambda/build.mjs",
    "infra:apply": "npm run build:lambdas && terraform -chdir=infra apply -auto-approve",
    "infra:destroy": "terraform -chdir=infra destroy -auto-approve",
    "infra:plan": "npm run build:lambdas && terraform -chdir=infra plan",
    "loadtest": "node scripts/loadtest.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1116.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/sensible": "^6.0.5",
    "fastify": "^5.12.1",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^6.0.0",
    "ulid": "^3.0.2",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
