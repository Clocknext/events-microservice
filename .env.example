NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug

# --- kafka (the ingest topic) -------------------------------------------------
# Comma-separated bootstrap brokers. Leave empty to run without producing: the
# gate behaves identically, a 202 just means "passed the gate" and nothing is
# published. Locally this is the KRaft container from docker-compose.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=signal-edge
# The single topic every gate-passing signal is produced to.
KAFKA_TOPIC=signals
# Local dev is PLAINTEXT. In production (MSK Serverless) set KAFKA_USE_IAM=true
# and point KAFKA_BROKERS at the MSK bootstrap endpoint; the IAM token is signed
# from the AWS default chain (the instance role), so no secret lives here.
KAFKA_USE_IAM=false
# AWS_REGION=us-east-1

# --- request limits -----------------------------------------------------------
BODY_BYTES=65536

# ==============================================================================
# THE DISPATCHER (`npm run dispatch`) — a SEPARATE process from the edge, run
# ONE-SHOT by a systemd timer every 60s. Not a loop, and not long-lived.
#
# The edge needs none of the below: it produces to Kafka and ClickHouse ingests
# on its own (Kafka table engine + materialized view, see docker/clickhouse/init).
# The dispatcher is the other half — it reads ONE WINDOW of the archive and posts
# it to /api/internal/settle in a single call, then exits. See
# docs/IMPLEMENTATION.md and docs/PRODUCTION.md for the timer units.
# ==============================================================================

# --- clickhouse (read-only) ---------------------------------------------------
# `signal_log` has exactly one writer, the materialized view. The dispatcher only
# ever selects from it, which is what keeps the archive rebuildable by replaying
# the topic.
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_DATABASE=signals
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# --- the payments app ---------------------------------------------------------
# Base URL of the app that owns pricing and Postgres.
PAYMENTS_URL=http://127.0.0.1:3001
# Shared secret proving the CALLER is us, sent as `Authorization: Bearer`. NOT a
# customer credential — it authenticates this service to /api/internal/*. The
# dispatcher refuses to start without one rather than 401 in a loop. Must match
# the payments deployment's own INTERNAL_SETTLE_SECRET.
INTERNAL_SETTLE_SECRET=

# --- dispatcher tuning --------------------------------------------------------
# How far back the window reaches, over `ingested_at`. Deliberately WIDER than
# the timer's 60s interval — at 3 minutes, 3x.
#
# That overlap IS the error recovery. Nothing is persisted between runs, so a run
# that fails is covered by the next two and nothing else. Every signal is sent
# about three times and settle discards all but the first (it is idempotent on
# signalId), which is why overlapping windows are free.
#
# The window is over `ingested_at`, never `received_at`: `received_at` is the
# caller's time stamped by N edge instances off N clocks, and a row can land in
# ClickHouse minutes after it — a window over `received_at` would miss that row
# permanently, because there is no watermark to come back for it. `received_at`
# is still what settle bills on.
DISPATCH_WINDOW_MS=180000
# Hard ceiling on rows per run. An OOM GUARD, not a batch size — the whole window
# goes in one call. ~150MB of Node heap at this value.
#
# Hitting it MEANS ROWS WERE NOT SENT and is logged at error level: the next
# window has already moved past some of them. The hourly reconciliation timer
# covers up to two hours of that; past it, replay with DISPATCH_SINCE.
DISPATCH_MAX_ROWS=100000
# Timeout on the one settle call. Must sit ABOVE the settle route's maxDuration:
# abandoning a call that is still committing makes the next window re-send work
# that actually succeeded.
DISPATCH_TIMEOUT_MS=310000
# gzip the settle request body. Effectively required in production — Vercel caps
# a serverless function's request body at 4.5MB, which raw JSON crosses somewhere
# around 15k signals. Signal JSON compresses roughly 10:1. Set false only to
# debug against a server that does not decompress.
DISPATCH_GZIP=true
# Manual replay window, ISO-8601, both empty in normal operation. Set them and
# the run ignores DISPATCH_WINDOW_MS and reads exactly [since, until) over
# `ingested_at`. This is how a gap from an outage longer than the reconciliation
# window is filled — no code change, no cursor to rewind:
#
#   DISPATCH_SINCE=2026-08-26T04:00:00Z DISPATCH_UNTIL=2026-08-26T05:00:00Z \
#     npm run dispatch
DISPATCH_SINCE=
DISPATCH_UNTIL=
