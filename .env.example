NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug

# --- kafka (the ingest topic) -------------------------------------------------
# Comma-separated bootstrap brokers. Leave empty to run without producing: the
# gate behaves identically, a 202 just means "passed the gate" and nothing is
# published. Locally this is the KRaft container from docker-compose.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=signal-edge
# The single topic every gate-passing signal is produced to.
KAFKA_TOPIC=signals
# Local dev is PLAINTEXT. In production (MSK Serverless) set KAFKA_USE_IAM=true
# and point KAFKA_BROKERS at the MSK bootstrap endpoint; the IAM token is signed
# from the AWS default chain (the instance role), so no secret lives here.
KAFKA_USE_IAM=false
# AWS_REGION=us-east-1

# --- request limits -----------------------------------------------------------
BODY_BYTES=65536

# ==============================================================================
# THE DISPATCHER (`npm run dispatch`) — a SEPARATE process from the edge.
#
# The edge needs none of the below: it produces to Kafka and ClickHouse ingests
# on its own (Kafka table engine + materialized view, see docker/clickhouse/init).
# The dispatcher is the other half — it READS the archive and posts batches to
# the payments app. See docs/IMPLEMENTATION.md.
# ==============================================================================

# --- clickhouse (read-only) ---------------------------------------------------
# `signal_log` has exactly one writer, the materialized view. The dispatcher only
# ever selects from it, which is what keeps the archive rebuildable by replaying
# the topic.
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_DATABASE=signals
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# --- the payments app ---------------------------------------------------------
# Base URL of the app that owns pricing and Postgres.
PAYMENTS_URL=http://127.0.0.1:3001
# Shared secret proving the CALLER is us, sent as `Authorization: Bearer`. NOT a
# customer credential — it authenticates this service to /api/internal/*. The
# dispatcher refuses to start without one rather than 401 in a loop. Must match
# the payments deployment's own INTERNAL_SETTLE_SECRET.
INTERNAL_SETTLE_SECRET=

# --- dispatcher tuning --------------------------------------------------------
# Signals per settle call. 500 is the route's own enforced cap. A bigger batch
# buys NO throughput — settle splits it across INTERNAL_WORKER workers that each
# walk their chunk one signal at a time — it only lengthens the wall time and
# worsens a timeout.
DISPATCH_BATCH_SIZE=500
# Settle calls in flight at once. THIS is the throughput lever. Keep it at or
# below the payments app's INTERNAL_BATCH_CONCURRENCY, or the extra batches just
# queue for a connection-pool slot.
DISPATCH_CONCURRENCY=2
# Nap when a sweep came back short. A FULL batch loops again immediately, so this
# is the idle cost, never the throughput ceiling.
DISPATCH_IDLE_MS=1000
# How far BELOW the watermark to re-read. ClickHouse's Kafka engine flushes in
# batches and several edge instances stamp receivedAt from their own clocks, so a
# row can land with a timestamp just under one already seen; without this window
# it is lost silently and for good.
#
# Keep it TIGHT. Rows inside the window that are already settled get re-read on
# every sweep and dropped by /api/internal/signals/known, and the sweep has to
# PAGE past them to reach new work — so a window far wider than the batch size
# makes that paging the dominant cost. 60s covers a 7.5s flush interval and any
# NTP-synced clock skew. If you widen it, watch for `sweep.page_cap` in the log.
DISPATCH_OVERLAP_MS=60000
# Cold-start guard, in signals. The watermark is max(receivedAt) over
# SignalStatus; with that table empty there is no watermark, so EVERY unsettled
# row in the archive counts as outstanding and the first run backfills the lot.
# Right when adopting the dispatcher is meant to backfill, wrong when the archive
# predates it — so on a cold start it refuses above this size and tells you the
# choices. 0 allows any size (the deliberate-backfill case). Once anything has
# settled there is a watermark and this never fires again.
DISPATCH_COLD_START_MAX=1000
