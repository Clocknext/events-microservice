NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug

# --- payments app (Vercel) ----------------------------------------------------
# Origin of the payments app. No trailing slash.
PAYMENTS_URL=https://payments.clocknext.com
# Shared secret for /api/internal/*. Sent as `Authorization: Bearer <secret>`;
# must match INTERNAL_SETTLE_SECRET on the payments deployment.
INTERNAL_SETTLE_SECRET=566e76a1e9a4385246862bfa0c7f1149755a091361456d6356463eb645c15aab
RESOLVE_TIMEOUT_MS=3000

# --- redis (api-key resolution cache) -----------------------------------------
# Leave empty to run without a cache: correct, just slower — every signal then
# resolves against the payments app.
REDIS_URL=redis://127.0.0.1:6379
# A revoked key keeps working for at most KEY_CACHE_TTL_SECONDS.
KEY_CACHE_TTL_SECONDS=60
# Shorter, so a key created seconds ago is not locked out.
KEY_CACHE_MISS_TTL_SECONDS=30

# --- aws / sqs (the reject vent) ----------------------------------------------
# Every response with a status of 400 or above is published here as two
# ClickHouse rows. Leave SQS_PENDING_QUEUE_URL empty to disable venting: the
# service behaves identically, nothing is queued.
#
# Credentials are NOT read from config — the AWS SDK's default chain finds them.
# Locally that means running with AWS_PROFILE=localstack in the environment.
AWS_REGION=us-east-1
# LocalStack's gateway. Leave empty to talk to real AWS.
AWS_ENDPOINT_URL=http://localhost:4566
# Both created by scripts/localstack/ready.d/01-queues.sh on `docker compose up`.
# signals_pending holds every response of 400 or above, behind a 60s delay.
SQS_PENDING_QUEUE_URL=http://localhost:4566/000000000000/signals_pending
# signals_accepted holds every accepted signal, with no delay. Publishing to it
# happens BEFORE the 202 and a failure is a 502 — a billable signal must not be
# acknowledged unless it is durably queued.
SQS_ACCEPTED_QUEUE_URL=http://localhost:4566/000000000000/signals_accepted

# --- clickhouse (the SQS consumers, not the edge) -----------------------------
# Read by the Lambda consumers in src/workers/, never by the edge. From the host
# this is localhost; inside a LocalStack Lambda it is the container name
# (http://clickhouse:8123), set by scripts/localstack/deploy-lambdas.sh.
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=signals
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# --- consumer sizing (read by scripts/localstack/deploy-lambdas.sh) -----------
# The SQS -> Lambda event-source-mapping settings. Change here, re-run
# `npm run deploy:lambdas`. These configure the mappings, not the edge.
#
# accepted: N concurrent consumers, each up to ACCEPTED_BATCH_SIZE signals.
ACCEPTED_BATCH_SIZE=50
ACCEPTED_CONCURRENCY=5
# pending: ONE consumer, draining a batch that accumulates over the window.
PENDING_BATCH_SIZE=100
PENDING_BATCH_WINDOW=60
PENDING_CONCURRENCY=1

# --- request limits -----------------------------------------------------------
BODY_BYTES=65536
CUSTOM_BYTES=32768
